# Copy this file to .env and enter credentials there, never in frontend code.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=
# NVIDIA_API_KEY is also supported for the NVIDIA endpoint.
# OpenRouter alternative:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_API_KEY=your_openrouter_key
# OPENROUTER_API_KEY is supported for the OpenRouter endpoint.
# Optional LLM_JSON_MODE=prompt or json_object; default depends on endpoint.
SHIRT_APP_PORT=8010
